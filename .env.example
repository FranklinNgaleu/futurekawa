SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Destinataire par defaut si aucune variable specifique au pays n'est definie
ALERT_EMAIL_TO=

# Destinataires specifiques par pays (prioritaires sur ALERT_EMAIL_TO)
ALERT_EMAIL_TO_BRESIL=
ALERT_EMAIL_TO_EQUATEUR=
ALERT_EMAIL_TO_COLOMBIE=

EXPIRED_LOTS_CHECK_INTERVAL_MINUTES=60
FALLBACK_CHECK_INTERVAL_MINUTES=5
FALLBACK_STALE_AFTER_MINUTES=15

# Registre JSON pays -> URL du backend-central ; laisser vide pour utiliser le
# fallback par defaut (les 3 backend-country du docker-compose.yml)
COUNTRY_BACKENDS=
